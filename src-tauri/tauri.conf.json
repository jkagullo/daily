{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Daily",
  "version": "0.1.1",
  "identifier": "dev.jkdev.daily",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Daily",
        "width": 340,
        "height": 560,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "jkdev",
    "copyright": "© 2026 jkdev. MIT License.",
    "category": "Productivity",
    "shortDescription": "Daily task panel for your tray",
    "longDescription": "A tiny always-there daily task panel that lives in your Windows tray: recurring tasks, progress, and a contribution-style heatmap. All data stays local.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY5QzBEQzZFN0ZDMzI1MkEKUldRcUpjTi9idHpBK1VRMDBNTzhXRFEzQStCTmt4TFBZNk5wQWFjM2I2NkNuTFQwT01vSyt4eGIK",
      "endpoints": [
        "https://github.com/jkagullo/daily/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
